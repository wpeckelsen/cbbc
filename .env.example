# Environment mode
# 'dev' = FTP cache enabled, model caps active, Shopify push capped
# ENV=dev
# 'prod' = cache cleared each run, no caps, full pipeline
ENV=prod


# in dev, pipeline automatically runs in startup
# in prod, pipeline does not automatically run in startup. uncomment the line below to enable it.
# RUN_ON_STARTUP=true

# Logging
LOG_LEVEL=debug
# LOG_LEVEL=info

# Cron FTP Schedule (Weekly, Monday at 03:00 am)
CRON_SCHEDULE=0 3 * * 1

# Cron Shopify Schedule (Weekly, Tuesday at 03:00 am)
SHOPIFY_PUSH_CRON=0 3 * * 2

# FTP connection
FTP_HOST=updateftp.duell.fi
FTP_USER=duellus
FTP_PASS=
FTP_PORT=21
FTP_SECURE=false
FTP_REJECT_UNAUTHORIZED=true


# product cap. default: 50 during dev, 0 (no limit) during production
# set to 0 for no limit
# PIPELINE_MODEL_LIMIT=0
# set to 0 for no limit
# SHOPIFY_PUSH_MODEL_LIMIT=0

# if set to false, pipeline won't filter for selected brands, found in 'brands.md'. default is true. just keep this line commented out.
# BRAND_FILTER_ENABLED=false



# PostgreSQL connection string (Railway)
# when pipeline runs in production in railway, it will use a private db url that is not accessible from outside of railway. 
# That url is set inside Railway. 
# When env=dev, DATABASE_PUBLIC_URL is used. 
# when env=prod, DATABASE_URL is used.

# this is the public db url from the staging env db in railway. it hits the staging db.
DATABASE_PUBLIC_URL=
# this is the public db url from the production env db in railway. it hits the production db.
DATABASE_URL=

# Shopify API config
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_PUBLICATION_ID=



# future Email notifications (via Resend)
EMAIL_ENABLED=false
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_TO=
# EMAIL_ON_SUCCESS=true
# EMAIL_ON_FAILURE=true

