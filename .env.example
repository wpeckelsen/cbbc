# Environment mode — REQUIRED, no default. Must be exactly 'dev' or 'prod'.
# 'dev'  = FTP cache enabled, model limits REQUIRED, brand filter REQUIRED,
#          log level debug.
# 'prod' = cache cleared each run, no model limits (unlimited), brand filter
#          always on, log level info.
ENV=prod

# FTP connection
FTP_HOST=updateftp.duell.fi
FTP_USER=duellus
FTP_PASS=
FTP_PORT=21
FTP_SECURE=false
FTP_REJECT_UNAUTHORIZED=true


# ── Dev-only levers (REQUIRED when ENV=dev, ignored when ENV=prod) ──────────
# Max models promoted to production tables per pipeline run (0 = unlimited).
# PIPELINE_MODEL_LIMIT=5
# Max models pushed to Shopify per push run (0 = unlimited).
# SHOPIFY_PUSH_MODEL_LIMIT=5
# Only process brands listed in brands.md (empty brands.md = allow all).
# BRAND_FILTER_ENABLED=true



# ── Database URL ─────────────────────────────────────────────────────────────
# One DB per environment: local, staging, and production each point at one DB.
#
# Locally: set this to the PUBLIC Railway URL (private URLs are unreachable
# from outside Railway).
# Inside Railway: set this to the PRIVATE URL via a reference variable
# (e.g. DB_URL = ${{Postgres.DATABASE_URL}}).

DB_URL=

# Shopify API config
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_PUBLICATION_ID=
SHOPIFY_LOCATION_ID=
