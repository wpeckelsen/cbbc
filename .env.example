# Environment variables for CBBC FTP Worker

# FTP Server Configuration
FTP_HOST=ftp.example.com
FTP_PORT=21
FTP_USER=your-ftp-username
FTP_PASS=your-ftp-password
FTP_SECURE=false  # Set to true for FTPS (secure FTP)

# Database Configuration (local dev: PostgreSQL, prod: Supabase)
DATABASE_URL=postgresql://user:pass@localhost:5432/cbbc_db

# For Supabase (production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Ecwid API Configuration
ECWID_STORE_ID=your-ecwid-store-id
ECWID_API_TOKEN=your-ecwid-api-token

# Logging
LOG_LEVEL=info

# Cron Schedule (default: daily at 2 AM)
CRON_SCHEDULE=0 2 * * *

# Other
NODE_ENV=development