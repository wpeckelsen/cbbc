# ---------------------------------------------------------------------------
# CBBC product pipeline — example environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Environment mode ---
# 'dev' = FTP cache enabled, model caps active, Shopify push capped
# 'prod' = cache cleared each run, no caps, full pipeline
ENV=dev
# ENV=prod

# FTP connection
FTP_HOST=updateftp.duell.fi
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_SECURE=false
# Verify TLS certificate for FTPS connections (default: true). Set to false only
# if the supplier uses a self-signed cert AND you accept the MITM risk.
FTP_REJECT_UNAUTHORIZED=true

# direct db connection string
# using session pooler
DATABASE_URL=
SUPABASE_API_BASE_URL=
SUPABASE_SECRET_KEY=

# Shopify API config
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_SECRET=
SHOPIFY_API_VERSION=2024-10
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Logging
# LOG_LEVEL=info
LOG_LEVEL=debug


#environment
env=dev
# env=prod


# Cron FTP Schedule (Weekly, Monday at 03:00 am)
CRON_SCHEDULE=0 3 * * 1

# Cron Shopify Schedule (Weekly, Tuesday at 03:00 am)
SHOPIFY_PUSH_CRON=0 3 * * 2

# Other
# Optional: inventory location to write stock to. Leave empty to use the store's
# first active location.
SHOPIFY_LOCATION_ID=
# Optional: weekly cron for the push. Empty = manual only (npm run shopify:push:prod).
# Recommended weekly run is Monday 03:00 (Sunday night -> Monday): 0 3 * * 1
SHOPIFY_PUSH_CRON=
# Force-push all models to Shopify regardless of content hash (bypasses
# skip-if-unchanged optimization). Set to true for first deploy after adding
# hash support, recovery, or manual full-push runs. Default: false.
SHOPIFY_FORCE_PUSH=false
# Max models to push per Shopify run. 0 = unlimited.
# Default: 5 in dev, unlimited in prod.
SHOPIFY_PUSH_MODEL_LIMIT=

# --- Pipeline worker scheduling ---
CRON_SCHEDULE=0 2 * * *
# Max models to promote in the pipeline. 0 = unlimited.
# Default: 50 in dev, unlimited in prod.
PIPELINE_MODEL_LIMIT=

# --- Misc ---
LOG_LEVEL=info
NODE_ENV=development
DEV_CLEAN_SLATE=false
