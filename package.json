{
  "name": "cbbc-ftp-worker",
  "version": "1.0.0",
  "description": "Scheduled service to fetch products from FTP, validate, store in DB, and sync to Ecwid",
  "main": "dist/worker.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "docker:build": "docker build -t cbbc-worker .",
    "docker:run": "docker run --env-file .env cbbc-worker"
  },
  "dependencies": {
    "basic-ftp": "^5.0.4",
    "csv-parser": "^3.0.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/node-cron": "^3.0.9",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}